{"transcript":"ngambang","exists":true,"definitions":["Mengapung di permukaan air atau udara.","Tidak jelas atau tidak pasti (tentang rencana, keputusan, dsb.).","Tidak membumi; melayang-layang."],"examples":["Sampah itu ngambang di sungai.","Rencananya masih ngambang.","Pikirannya sering ngambang."],"lemma":"ngambang","lemmaPos":"verb","synonyms":["mengapung","melayang","terkatung-katung"],"number":"singular","tense":"present","source":"ngambang"}